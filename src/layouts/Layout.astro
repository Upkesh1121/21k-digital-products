---
import '../styles/global.css';

const {
  title = '21K Build — Build Websites, Digital Products & AI Business Systems',
  description = '21K Build helps beginners, students, and creators use AI to build websites, digital products, templates, and launch-ready online business systems.',
  path = '/',
  image = '/og.svg',
  schema,
} = Astro.props;

const siteUrl = 'https://21k.in';
const canonical = new URL(path, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="21K Build" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, siteUrl).toString()} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl).toString()} />
    <meta name="theme-color" content="#020403" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  </head>
  <body>
    <slot />
    <script is:inline>
      document.querySelectorAll('[data-access-vault]').forEach((vault) => {
        const form = vault.querySelector('[data-access-form]');
        const input = form?.querySelector('input[name="access-code"]');
        const message = vault.querySelector('[data-access-message]');
        const resources = vault.querySelector('[data-locked-resources]');
        const codeOutput = vault.querySelector('[data-purchase-code]');
        const codeDisplay = vault.querySelector('[data-code-display]');
        const codeEntry = vault.querySelector('[data-code-entry]');
        const buyButtons = document.querySelectorAll('[data-buy-course]');

        const showCodeEntry = (accessCode) => {
          vault.classList.add('is-paid');
          if (codeDisplay) codeDisplay.hidden = false;
          if (codeEntry) codeEntry.hidden = false;
          if (codeOutput) codeOutput.textContent = accessCode;
          if (input) input.value = accessCode;
          window.localStorage.setItem('21k-resource-payment-code', accessCode);
        };

        const unlock = (accessCode) => {
          vault.classList.add('is-unlocked');
          if (resources) resources.hidden = false;
          if (message) message.textContent = 'Access granted. Resource vault unlocked.';
          showCodeEntry(accessCode);
          window.localStorage.setItem('21k-resource-access', 'unlocked');
          window.localStorage.setItem('21k-resource-code', accessCode);
        };

        const storedPaymentCode = window.localStorage.getItem('21k-resource-payment-code');
        if (storedPaymentCode) {
          showCodeEntry(storedPaymentCode);
        }

        const storedUnlockedCode = window.localStorage.getItem('21k-resource-code');
        if (window.localStorage.getItem('21k-resource-access') === 'unlocked' && storedUnlockedCode) {
          unlock(storedUnlockedCode);
        }

        form?.addEventListener('submit', (event) => {
          event.preventDefault();
          const value = input?.value.trim();
          if (!value) return;
          if (message) message.textContent = 'Verifying generated code...';

          fetch('/api/verify-access-code', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ accessCode: value }),
          })
            .then(async (response) => {
              const result = await response.json();
              if (!response.ok) throw new Error(result.error || 'Access code verification failed.');
              unlock(value);
            })
            .catch((error) => {
              if (message) message.textContent = error.message || 'Invalid access code.';
            });
        });

        buyButtons.forEach((button) => {
          button.addEventListener('click', async (event) => {
            event.preventDefault();
            vault.scrollIntoView({ behavior: 'smooth', block: 'center' });

            if (message) message.textContent = 'Creating secure payment...';

            try {
              const orderResponse = await fetch('/api/create-order', { method: 'POST' });
              const order = await orderResponse.json();

              if (!orderResponse.ok) {
                throw new Error(order.error || 'Payment setup failed.');
              }

              if (!window.Razorpay) {
                throw new Error('Razorpay Checkout could not be loaded.');
              }

              const checkout = new window.Razorpay({
                key: order.key,
                amount: order.amount,
                currency: order.currency,
                name: order.name,
                description: order.description,
                order_id: order.orderId,
                theme: {
                  color: '#00d9ff',
                  backdrop_color: '#02030a',
                },
                modal: {
                  ondismiss: () => {
                    if (message) message.textContent = 'Payment window closed. You can try again anytime.';
                  },
                },
                handler: async (payment) => {
                  if (message) message.textContent = 'Verifying payment...';
                  const verifyResponse = await fetch('/api/verify-payment', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payment),
                  });
                  const verify = await verifyResponse.json();

                  if (!verifyResponse.ok) {
                    throw new Error(verify.error || 'Payment verification failed.');
                  }

                  showCodeEntry(verify.accessCode);
                  if (message) message.textContent = 'Payment verified. Your generated access code is ready below.';
                },
              });

              checkout.open();
            } catch (error) {
              if (message) message.textContent = error.message || 'Payment could not start.';
            }
          });
        });
      });

      document.querySelectorAll('[data-countdown]').forEach((block) => {
        const storageKey = '21k-limited-drop-deadline';
        const hours = Number(block.getAttribute('data-deadline-hours') || 36);
        let deadline = Number(window.localStorage.getItem(storageKey));

        if (!deadline || deadline < Date.now()) {
          deadline = Date.now() + hours * 60 * 60 * 1000;
          window.localStorage.setItem(storageKey, String(deadline));
        }

        const seatsEl = block.querySelector('[data-seats-left]');
        const daysEl = block.querySelector('[data-days]');
        const hoursEl = block.querySelector('[data-hours]');
        const minutesEl = block.querySelector('[data-minutes]');
        const secondsEl = block.querySelector('[data-seconds]');

        const update = () => {
          const remaining = Math.max(0, deadline - Date.now());
          const totalSeconds = Math.floor(remaining / 1000);
          const days = Math.floor(totalSeconds / 86400);
          const hrs = Math.floor((totalSeconds % 86400) / 3600);
          const mins = Math.floor((totalSeconds % 3600) / 60);
          const secs = totalSeconds % 60;
          const seats = Math.max(4, Math.ceil(totalSeconds / 6200));

          if (seatsEl) seatsEl.textContent = String(seats).padStart(2, '0');
          if (daysEl) daysEl.textContent = String(days).padStart(2, '0');
          if (hoursEl) hoursEl.textContent = String(hrs).padStart(2, '0');
          if (minutesEl) minutesEl.textContent = String(mins).padStart(2, '0');
          if (secondsEl) secondsEl.textContent = String(secs).padStart(2, '0');
        };

        update();
        window.setInterval(update, 1000);
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion) {
        document.documentElement.classList.add('motion-ready');

        const revealTargets = document.querySelectorAll('.hero-grid, .section, .simple-hero, .footer, .error-page .content-block');
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.14 });

        revealTargets.forEach((target) => observer.observe(target));

        const tiltTargets = document.querySelectorAll('.card, .signal-panel, .content-block, .roadmap-step, details, .form, .mockup-choice, .mockup-console, .resource-card, .access-vault');
        tiltTargets.forEach((target) => {
          target.addEventListener('pointermove', (event) => {
            const rect = target.getBoundingClientRect();
            const x = (event.clientX - rect.left) / rect.width - 0.5;
            const y = (event.clientY - rect.top) / rect.height - 0.5;
            target.style.setProperty('--rx', `${(-y * 7).toFixed(2)}deg`);
            target.style.setProperty('--ry', `${(x * 8).toFixed(2)}deg`);
            target.style.setProperty('--mx', `${(x + 0.5) * 100}%`);
            target.style.setProperty('--my', `${(y + 0.5) * 100}%`);
          });

          target.addEventListener('pointerleave', () => {
            target.style.removeProperty('--rx');
            target.style.removeProperty('--ry');
            target.style.removeProperty('--mx');
            target.style.removeProperty('--my');
          });
        });

        document.querySelectorAll('.mockup-console').forEach((consoleEl) => {
          const choices = consoleEl.querySelectorAll('.mockup-choice');
          choices.forEach((choice) => {
            choice.addEventListener('click', () => {
              choices.forEach((item) => {
                item.classList.remove('is-active');
                item.setAttribute('aria-selected', 'false');
              });
              choice.classList.add('is-active');
              choice.setAttribute('aria-selected', 'true');
              consoleEl.setAttribute('data-active-mockup', choice.dataset.mockup);
            });
          });
        });
      }
    </script>
  </body>
</html>
