---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="About Us — 21K Build" description="Learn about 21K Build, a premium digital products platform for AI-assisted website, template, and business system creation." path="/about/">
  <div class="page">
    <Header />
    <main>
      <section class="simple-hero">
        <p class="eyebrow">About us</p>
        <h1>A build-first platform for the AI era.</h1>
        <p class="hero-copy">21K Build exists to help new builders turn AI capability into real published projects.</p>
      </section>
      <section class="section">
        <div class="content-block">
          <p>21K Build is a digital products ecosystem focused on practical execution. We create guides, templates, prompt systems, and launch workflows for students, creators, and beginners who want to build websites, digital products, and online business systems with AI.</p>
          <p>The platform is built around a simple belief: skills compound faster when you ship real things. Each product is designed to reduce confusion, give structure to the build process, and help beginners move from passive learning to visible output.</p>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
