---
import Layout from '../layouts/Layout.astro';
---

<Layout title="500 — Server Error | 21K Build" description="Something went wrong while loading 21K Build." path="/500/">
  <main class="error-page">
    <section class="content-block">
      <p class="eyebrow">500</p>
      <h1>Something went wrong.</h1>
      <p>The site hit an unexpected issue. Try again, or return to the home page.</p>
      <div class="actions">
        <a class="button primary" href="/">Return Home</a>
        <a class="button secondary" href="/contact/">Contact Support</a>
      </div>
    </section>
  </main>
</Layout>
