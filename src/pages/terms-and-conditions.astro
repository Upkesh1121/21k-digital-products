---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms & Conditions — 21K Build" description="Read the 21K Build terms and conditions for digital products, access, usage, and limitations." path="/terms-and-conditions/">
  <div class="page">
    <Header />
    <main>
      <section class="simple-hero">
        <p class="eyebrow">Terms</p>
        <h1>Terms & Conditions</h1>
        <p class="hero-copy">Last updated: June 11, 2026</p>
      </section>
      <section class="section">
        <article class="content-block">
          <p>By using 21K Build, you agree to use the website and digital products responsibly and for lawful purposes. Product access is provided digitally and may include guides, prompts, templates, and related resources.</p>
          <p>Digital products are educational and execution-focused resources. Results depend on your effort, market, offer, execution quality, and external factors. 21K Build does not guarantee income, business results, rankings, or specific outcomes.</p>
          <p>You may use purchased resources for your own projects, but you may not resell, redistribute, copy, or claim the products as your own unless a specific license says otherwise.</p>
        </article>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
