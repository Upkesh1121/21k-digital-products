---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const freeTools = [
  ['Logo & Favicon', 'Create quick brand marks and favicon ideas.', 'https://logofa.st/'],
  ['Ahrefs Keyword Generator', 'Find keyword ideas for product pages and SEO content.', 'https://ahrefs.com/keyword-generator'],
  ['Domain Search', 'Check domain ideas before buying a name.', 'https://instantdomainsearch.com/'],
  ['AstroJS Docs', 'Official documentation for Astro websites.', 'https://docs.astro.build/en/getting-started/'],
];

const resourceLinks = [
  ['Web Design Guidelines', 'Premium design references for sharper layouts and UI decisions.', 'https://www.skills.sh/vercel-labs/agent-skills/web-design-guidelines'],
  ['Tailwind v4 Docs', 'Tailwind CSS v4 agent skill documentation.', 'https://www.skills.sh/lombiq/tailwind-agent-skills/tailwind-4-docs'],
  ['Tailwind Agent Skills Repo', 'GitHub source for Tailwind agent skill references.', 'https://github.com/Lombiq/Tailwind-Agent-Skills'],
  ['Google Analytics', 'Set up traffic and event measurement.', 'https://analytics.google.com'],
  ['Google Search Console', 'Submit the site and monitor search indexing.', 'https://search.google.com/search-console/about'],
  ['Bing Webmaster', 'Submit and monitor the site on Bing search.', 'https://www.bing.com/webmasters/about'],
  ['Google AdSense', 'Explore monetization after the site has useful traffic.', 'https://adsense.google.com/start/'],
];
---

<Layout title="Resources — 21K Build" description="Free tools and buyer-only course resources for 21K Build." path="/resources/">
  <div class="page">
    <Header />
    <main>
      <section class="simple-hero">
        <p class="eyebrow">Resources</p>
        <h1>Tools, setup links, and buyer-only access.</h1>
        <p class="hero-copy">Use the free tools before purchase, then unlock the private course vault after payment verification.</p>
      </section>

      <section class="section">
        <div class="section-heading">
          <p class="eyebrow">Free tools</p>
          <h2>Useful tools before you buy.</h2>
          <p>Start with these free tools for branding, keyword research, domain search, and Astro documentation.</p>
        </div>
        <div class="resource-grid">
          {freeTools.map(([name, copy, href]) => (
            <a class="resource-card" href={href} target="_blank" rel="noopener noreferrer">
              <span>Free</span>
              <strong>{name}</strong>
              <p>{copy}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="access-vault" id="buyer-vault" data-access-vault>
          <div class="vault-copy">
            <p class="eyebrow">Buyer resource vault</p>
            <h2>Pay first. Then enter your generated code.</h2>
            <p>The access-code section appears only after Razorpay confirms payment. The code is generated by the backend from that successful payment.</p>
            <div class="purchase-code" data-code-display hidden>
              <span>Generated access code</span>
              <strong data-purchase-code>Waiting for payment</strong>
            </div>
            <div class="payment-methods" aria-label="Supported payment methods">
              <span>UPI</span>
              <span>Cards</span>
              <span>Netbanking</span>
              <span>Wallets</span>
            </div>
          </div>

          <form class="access-form" data-access-form>
            <button class="button primary" type="button" data-buy-course>Pay ₹499 & Generate Code</button>
            <p class="payment-note">Pay with UPI, debit card, credit card, netbanking, or supported wallets through Razorpay Checkout.</p>
            <div class="code-entry" data-code-entry hidden>
              <div class="divider-line"><span>payment verified</span></div>
              <label class="field">
                Access code
                <input name="access-code" autocomplete="off" placeholder="Paste generated code" required />
              </label>
              <button class="button secondary" type="submit">Verify Code & Unlock</button>
            </div>
            <p class="access-message" data-access-message aria-live="polite"></p>
          </form>

          <div class="locked-resources" data-locked-resources hidden>
            <div class="section-heading compact">
              <p class="eyebrow">Unlocked resources</p>
              <h2>Course resource links.</h2>
              <p>Use these links after the course purchase to set up design, analytics, search indexing, and monetization.</p>
            </div>
            <div class="resource-grid">
              {resourceLinks.map(([name, copy, href]) => (
                <a class="resource-card premium" href={href} target="_blank" rel="noopener noreferrer">
                  <span>Unlocked</span>
                  <strong>{name}</strong>
                  <p>{copy}</p>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>
      <section class="section">
        <div class="limited-drop compact-drop" data-countdown data-deadline-hours="36">
          <div>
            <p class="eyebrow">Batch closes soon</p>
            <h2><span data-seats-left>21</span> buyer seats left.</h2>
            <p>Complete payment before the timer ends to secure this batch access.</p>
          </div>
          <div class="countdown-grid" aria-label="Offer countdown">
            <div><strong data-days>00</strong><span>Days</span></div>
            <div><strong data-hours>00</strong><span>Hours</span></div>
            <div><strong data-minutes>00</strong><span>Minutes</span></div>
            <div><strong data-seconds>00</strong><span>Seconds</span></div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
