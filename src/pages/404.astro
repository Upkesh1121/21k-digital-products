---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Page Not Found | 21K Build" description="The page you are looking for could not be found." path="/404/">
  <main class="error-page">
    <section class="content-block">
      <p class="eyebrow">404</p>
      <h1>Page not found.</h1>
      <p>The page may have moved, or the link is no longer available.</p>
      <div class="actions">
        <a class="button primary" href="/">Return Home</a>
        <a class="button secondary" href="/products/">Explore Products</a>
      </div>
    </section>
  </main>
</Layout>
