---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Privacy Policy — 21K Build" description="Read the 21K Build privacy policy for digital product access, analytics, and contact information." path="/privacy-policy/">
  <div class="page">
    <Header />
    <main>
      <section class="simple-hero">
        <p class="eyebrow">Privacy policy</p>
        <h1>Privacy Policy</h1>
        <p class="hero-copy">Last updated: June 11, 2026</p>
      </section>
      <section class="section">
        <article class="content-block">
          <p>21K Build collects only the information needed to provide digital products, respond to messages, improve the website, and understand basic site performance.</p>
          <p>Information may include your name, email address, contact message, purchase details, and analytics data collected through standard tools such as Google Analytics. We do not sell personal information.</p>
          <p>Payment processing, product delivery, analytics, and hosting providers may process information according to their own privacy practices. You can contact us to request access, correction, or deletion of your personal information where applicable.</p>
        </article>
      </section>
    </main>
    <Footer />
  </div>
</Layout>
